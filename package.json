{
  "name": "robridge",
  "version": "0.1.6",
  "private": true,
  "description": "RoBridge — local MCP server + web dashboard bridging AI agents to Roblox Studio",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "robridge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "install-plugin": "node dist/index.js install-plugin",
    "init": "node dist/index.js init",
    "mcp": "node dist/index.js mcp",
    "catalog": "node scripts/extract-tool-catalog.mjs",
    "test": "npm run test:schema && npm run test:hints",
    "test:mvp": "node scripts/mvp-test.mjs",
    "test:ui": "node scripts/ui-play-test.mjs",
    "test:parity": "node scripts/tools-parity-test.mjs",
    "test:schema": "node scripts/schema-parity-test.mjs",
    "test:hints": "node --test scripts/error-hints-test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "plugin",
    "ui",
    "docs",
    "scripts/install-plugin.mjs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Allusia1/RoBridge.git"
  },
  "bugs": {
    "url": "https://github.com/Allusia1/RoBridge/issues"
  },
  "homepage": "https://github.com/Allusia1/RoBridge#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
